<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_orders_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_orders"
    android:contentDescription="@string/widget_orders_description"
    android:padding="5dp">

    <ImageView
        android:id="@+id/widget_orders_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_orders_description"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_order" />

</FrameLayout>
